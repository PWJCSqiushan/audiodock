# Backend allowed browser origins (no path, comma-separated).
AUDIODOCK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUDIODOCK_RUNTIME_DIR=./runtime
AUDIODOCK_TRUST_PROXY=false
# Put frontend variables in web/.env.local or CI variables; never add credentials.
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_BASE_PATH=/
